# Port of .env.example from the original repository.

PORT=3000
SIMILARITY_THRESHOLD=0.58
TOP_K=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Original used LLM_MODEL_PATH=./models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf for node-llama-cpp.
# The LAYA equivalent selects a checkpoint family, not a local file.
LAYA_MODEL=english
LLM_TIMEOUT_MS=30000
CATALOG_FILE=./source
CATALOG_INDEX_FILE=./data/catalog-index.json
