# Port of .env.example from the original repository.

PORT=3000
# Retrieval gate. The original default was 0.58; 0.45 is the measured value for
# this corpus. Note that the in-corpus and out-of-scope score distributions
# overlap, so no value separates them perfectly — see EVAL_REPORT.md.
SIMILARITY_THRESHOLD=0.45
TOP_K=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Original used LLM_MODEL_PATH=./models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf for node-llama-cpp.
# The LAYA equivalent selects a checkpoint family, not a local file.
LAYA_MODEL=english
LLM_TIMEOUT_MS=30000
CATALOG_FILE=./source
CATALOG_INDEX_FILE=./data/catalog-index.json

# --------------------------------------------------------------------------- #
# Port additions: answering strategy (see src/answerer.py)
# --------------------------------------------------------------------------- #
# hybrid = answer from the retrieved nodes without a model call, and only reach
# for a model when no node answer can be produced.
# legacy = the original pipeline (call LAYA on every match), kept for comparison.
ANSWER_MODE=hybrid
# Score window treated as a tie: every node inside it is returned, so an
# underspecified question yields all its variants instead of one arbitrary one.
TIE_EPSILON=0.05
# Never stitch more than this many nodes into one reply.
MAX_TIE_NODES=3
# Reject heading-only nodes (the "answered with the document title" bug).
DROP_CONTENTLESS_NODES=true
# Split "A and B" / "compare A and B" questions and answer each half.
ENABLE_COMPOUND_SPLIT=true
# Answer electrical-safety reports with the catalog's own escalation policy.
ENABLE_HAZARD_ESCALATION=true
# For "under Rp X" questions, list every product at or below the ceiling.
ENABLE_BUDGET_LISTING=true
# Entries in the normalised-query response cache. 0 disables it.
QUERY_CACHE_SIZE=256
# Load the LAYA checkpoint during startup (~1.6 GB, several seconds). Off by
# default: the deterministic path means most installs never need it.
WARM_LAYAP=false

# Optional OpenAI-compatible synthesizer, used only when a node answer cannot be
# produced. Leave SYNTHESIZER_BASE_URL empty to run fully locally at zero cost.
SYNTHESIZER_BASE_URL=
SYNTHESIZER_MODEL=
SYNTHESIZER_API_KEY=
SYNTHESIZER_TIMEOUT_MS=20000
